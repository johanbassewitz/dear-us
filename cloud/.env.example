# Copy to .env on the server and fill in. Never commit .env.

API_DOMAIN=api.dearus.app
PUBLIC_URL=https://api.dearus.app
POSTGRES_PASSWORD=change-me-long-random
# 32+ random characters: openssl rand -hex 32
SERVER_SECRET=

# Cloudflare R2 (bucket "dearus-relay"; add a lifecycle rule: delete objects after 30 days)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=dearus-relay
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cupid (Google AI Studio, paid tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Microsoft Store purchases (Partner Center → Azure AD app; see docs/STORE_RELEASE.md)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_PRODUCT_PREMIUM_MONTHLY=
MS_PRODUCT_PREMIUM_YEARLY=
MS_PRODUCT_ARROWS_100=
MS_PRODUCT_ARROWS_300=

# Plan limits (defaults shown)
TRIAL_DAYS=30
FREE_MEDIA_MB=100
FREE_CUPID_PER_MONTH=10
PREMIUM_CUPID_PER_MONTH=100
MAILBOX_TTL_DAYS=30
