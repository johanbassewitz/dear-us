{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dear Us",
  "version": "1.0.1",
  "identifier": "app.dearus.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dear Us",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#f7f3ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: media: http://media.localhost; media-src 'self' blob: media: http://media.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "publisher": "Dear Us",
    "shortDescription": "A private, shared journal for two",
    "longDescription": "Dear Us keeps your memories, letters, plans and dreams on your own PCs, synced privately with your partner.",
    "copyright": "Made with love, for two",
    "category": "Lifestyle",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1NkZDQjlGQTE4RTNBNDgKUldSSU9vNmhuOHR2aFptalcxb0J0MDRRWXR0b0FJczRFcHVhQnZydHJmMkhYZSt6eFYwM21ZNFkK",
      "endpoints": [
        "https://github.com/johanbassewitz/dear-us/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}